{
  "datasets": [
    {
      "name": "wide",
      "displayName": "Indicators by country and year",
      "query": "SELECT country_name, region, income_level, year, make_date(year, 1, 1) AS year_date,\n  electricity_access_pct, gdp_per_capita_usd, co2_per_capita_t, life_expectancy_years,\n  under5_mortality_per_1000, internet_users_pct, poverty_3usd_day_pct\nFROM wb_demo.gold.country_indicator_wide"
    },
    {
      "name": "latest",
      "displayName": "Latest values by country",
      "query": "SELECT country_name, region, income_level,\n  max_by(gdp_per_capita_usd, IF(gdp_per_capita_usd IS NULL, NULL, year)) AS gdp_per_capita_usd,\n  max_by(electricity_access_pct, IF(electricity_access_pct IS NULL, NULL, year)) AS electricity_access_pct,\n  max_by(life_expectancy_years, IF(life_expectancy_years IS NULL, NULL, year)) AS life_expectancy_years,\n  max(year) AS latest_year\nFROM wb_demo.gold.country_indicator_wide GROUP BY ALL"
    }
  ],
