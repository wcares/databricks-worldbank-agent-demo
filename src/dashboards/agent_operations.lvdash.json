{
  "datasets": [
    {
      "name": "requests",
      "displayName": "Agent requests",
      "query": "SELECT source, state, date_format(timestamp_millis(request_time), 'yyyy-MM-dd HH:mm') AS requested_at,\n  round(latency_ms / 1000.0, 1) AS latency_s, coalesce(correctness, '') AS correctness, question\nFROM wb_demo.ops.agent_requests"
    },
    {
      "name": "versions",
      "displayName": "Agent model versions",
      "query": "SELECT version, concat('v', version, IF(aliases = '', '', concat(' (', aliases, ')'))) AS version_label,\n  correctness, relevance, safety, cites_source, declines_off_topic, llm_endpoint, aliases\nFROM wb_demo.ops.model_versions"
    },
    {
      "name": "champion",
      "displayName": "Champion model version",
      "query": "SELECT version, correctness FROM wb_demo.ops.model_versions WHERE aliases LIKE '%champion%'"
    },
    {
      "name": "jobs",
      "displayName": "Job runs",
      "query": "SELECT regexp_replace(job_name, '^\\\\[dev [^]]*\\\\] ', '') AS job,\n  date_format(start_time, 'yyyy-MM-dd HH:mm') AS started_at, duration_s, coalesce(result_state, life_cycle_state) AS result,\n  failed_tasks FROM wb_demo.ops.job_runs"
    },
    {
      "name": "audit_daily",
      "displayName": "Audit events per day",
      "query": "SELECT date_format(event_time, 'yyyy-MM-dd') AS day,\n  IF(status_code >= 400, 'failed or denied', 'succeeded') AS outcome, count(*) AS events\nFROM wb_demo.ops.v_audit_wb_demo GROUP BY ALL"
    },
    {
      "name": "denied",
      "displayName": "Failed or denied requests",
      "query": "SELECT date_format(event_time, 'yyyy-MM-dd HH:mm:ss') AS event_time, actor, service_name, action_name,\n  status_code, left(error_message, 160) AS error_message FROM wb_demo.ops.v_audit_denied"
    }
  ],
  "pages": [
